# durable_poc's FastAPI base URL (workflows/runs/profiles REST + SSE).
PUBLIC_DURABLE_API_URL=http://127.0.0.1:8010

# Mock mode: serve a stand-in executor from this app (see README). `pnpm dev:mock`
# sets both of these for you; leave them unset to use the real durable_poc API.
# DURABLE_MOCK=1
# PUBLIC_DURABLE_API_URL=http://localhost:5173/mock-api

# Path to the durable_poc checkout, for reading evaluation fixtures
# (evaluation/scenarios/<fixture>/conversation.json) directly off disk.
# Defaults to ../durable_poc relative to this app's working directory.
# DURABLE_POC_ROOT=../durable_poc

# Bedrock is the unconditional default/production model path.
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
# AWS_REGION=us-east-1

# Dev-only override: set OPENROUTER_API_KEY to route chat/agentic LLM turns
# through OpenRouter instead of Bedrock. Never set this in production.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL_ID=anthropic/claude-sonnet-5

# /voice's server-side speech layer (AWS Transcribe Streaming + Polly).
# Shares AWS_REGION and the default AWS credential provider chain with Bedrock.
# TRANSCRIBE_LANGUAGE_CODE=en-GB
# POLLY_VOICE_ID=Amy
