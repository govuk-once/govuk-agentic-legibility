<?xml version="1.0" encoding="UTF-8"?>

<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:meta="urn:durable-workflow:metadata:v1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    targetNamespace="urn:durable-workflow:processes:v1"
    id="address_update_definition">

    <!-- ===================================================== -->
    <!-- Errors                                                -->
    <!-- ===================================================== -->

    <bpmn:error
        id="ApiFailure"
        name="ApiFailure"/>

    <bpmn:error
        id="InvalidAddress"
        name="InvalidAddress"/>

    <!-- ===================================================== -->
    <!-- Process                                               -->
    <!-- ===================================================== -->

    <bpmn:process
        id="address_update"
        name="Address Update"
        isExecutable="true">

        <bpmn:extensionElements>

            <meta:workflowMetadata
                name="Address Update"
                version="1.0.0"/>

            <meta:processContract>

                <meta:input
                    name="driver_id"
                    type="string"
                    required="true"/>

                <meta:input
                    name="address"
                    type="object"
                    required="true"/>

                <meta:input
                    name="photo_id"
                    type="string"
                    required="true"/>

                <meta:input
                    name="signature_id"
                    type="string"
                    required="true"/>

                <meta:output
                    name="job_id"
                    type="string"
                    required="true"/>

                <meta:output
                    name="status"
                    type="string"
                    required="true"/>

            </meta:processContract>

        </bpmn:extensionElements>

        <!-- ================================================== -->
        <!-- Start                                              -->
        <!-- ================================================== -->

        <bpmn:startEvent id="start">
            <bpmn:outgoing>f1</bpmn:outgoing>
        </bpmn:startEvent>

        <!-- ================================================== -->
        <!-- Submit Address Update                              -->
        <!-- ================================================== -->

        <bpmn:serviceTask
            id="submit_address_update"
            name="Submit Address Update">

            <bpmn:incoming>f1</bpmn:incoming>
            <bpmn:outgoing>f2</bpmn:outgoing>

            <bpmn:extensionElements>

                <meta:taskHandler type="http"/>

                <meta:httpService
                    method="POST"
                    service="dvla"
                    endpoint="/app/dvla/v1/licence/address">

                    <meta:retry
                        attempts="3"
                        backoff_seconds="5"/>

                    <meta:timeout
                        duration="PT30S"/>

                    <meta:input
                        source="driver_id"
                        target="driver_id"/>

                    <meta:input
                        source="address"
                        target="address"/>

                    <meta:input
                        source="photo_id"
                        target="photo_id"/>

                    <meta:input
                        source="signature_id"
                        target="signature_id"/>

                    <meta:output
                        source="response.body.job_id"
                        target="job_id"/>

                    <meta:output
                        source="response.body.code"
                        target="submission_code"/>

                </meta:httpService>

            </bpmn:extensionElements>

        </bpmn:serviceTask>

        <!-- ================================================== -->
        <!-- Submission Error                                   -->
        <!-- ================================================== -->

        <bpmn:boundaryEvent
            id="submit_error"
            attachedToRef="submit_address_update"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>f_error</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Poll Job Status                                    -->
        <!-- ================================================== -->

        <bpmn:serviceTask
            id="poll_job_status"
            name="Poll Job Status">

            <bpmn:incoming>f2</bpmn:incoming>
            <bpmn:incoming>f_retry_poll</bpmn:incoming>

            <bpmn:outgoing>f3</bpmn:outgoing>

            <bpmn:extensionElements>

                <meta:taskHandler type="http"/>

                <meta:httpService
                    method="GET"
                    service="dvla"
                    endpoint="/app/dvla/v1/jobs/${job_id}">

                    <meta:retry
                        attempts="3"
                        backoff_seconds="5"/>

                    <meta:timeout
                        duration="PT30S"/>

                    <meta:output
                        source="response.body.state"
                        target="status"/>

                </meta:httpService>

            </bpmn:extensionElements>

        </bpmn:serviceTask>

        <!-- ================================================== -->
        <!-- Poll Error                                         -->
        <!-- ================================================== -->

        <bpmn:boundaryEvent
            id="poll_error"
            attachedToRef="poll_job_status"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>f_error</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Completed?                                         -->
        <!-- ================================================== -->

        <bpmn:exclusiveGateway
            id="status_gateway"
            default="f_pending">

            <bpmn:incoming>f3</bpmn:incoming>

            <bpmn:outgoing>f_completed</bpmn:outgoing>
            <bpmn:outgoing>f_pending</bpmn:outgoing>

        </bpmn:exclusiveGateway>

        <!-- ================================================== -->
        <!-- Wait Before Retry                                  -->
        <!-- ================================================== -->

        <bpmn:intermediateCatchEvent
            id="wait_before_retry">

            <bpmn:incoming>f_pending</bpmn:incoming>
            <bpmn:outgoing>f_retry_poll</bpmn:outgoing>

            <bpmn:timerEventDefinition>

                <bpmn:timeDuration>
                    PT5S
                </bpmn:timeDuration>

            </bpmn:timerEventDefinition>

        </bpmn:intermediateCatchEvent>

        <!-- ================================================== -->
        <!-- Success                                            -->
        <!-- ================================================== -->

        <bpmn:endEvent
            id="success"
            name="Address Updated">

            <bpmn:incoming>f_completed</bpmn:incoming>

        </bpmn:endEvent>

        <!-- ================================================== -->
        <!-- Api Failure                                        -->
        <!-- ================================================== -->

        <bpmn:endEvent
            id="api_failure_end"
            name="API Failure">

            <bpmn:incoming>f_error</bpmn:incoming>

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

        </bpmn:endEvent>

        <!-- ================================================== -->
        <!-- Sequence Flows                                     -->
        <!-- ================================================== -->

        <bpmn:sequenceFlow
            id="f1"
            sourceRef="start"
            targetRef="submit_address_update"/>

        <bpmn:sequenceFlow
            id="f2"
            sourceRef="submit_address_update"
            targetRef="poll_job_status"/>

        <bpmn:sequenceFlow
            id="f3"
            sourceRef="poll_job_status"
            targetRef="status_gateway"/>

        <bpmn:sequenceFlow
            id="f_completed"
            sourceRef="status_gateway"
            targetRef="success">

            <bpmn:conditionExpression
                xsi:type="bpmn:tFormalExpression">

                status == 'COMPLETED'

            </bpmn:conditionExpression>

        </bpmn:sequenceFlow>

        <bpmn:sequenceFlow
            id="f_pending"
            sourceRef="status_gateway"
            targetRef="wait_before_retry"/>

        <bpmn:sequenceFlow
            id="f_retry_poll"
            sourceRef="wait_before_retry"
            targetRef="poll_job_status"/>

        <bpmn:sequenceFlow
            id="f_error"
            sourceRef="submit_error"
            targetRef="api_failure_end"/>

    </bpmn:process>

</bpmn:definitions>