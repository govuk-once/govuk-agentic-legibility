<?xml version="1.0" encoding="UTF-8"?>

<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:meta="urn:durable-workflow:metadata:v1">

    <bpmn:error id="DeliveryFailure"/>

    <bpmn:process
        id="finalisation"
        isExecutable="true">

        <bpmn:startEvent id="start"/>

        <bpmn:serviceTask
            id="send_confirmation"
            name="Send Confirmation Email"/>

        <bpmn:serviceTask
            id="trigger_reissue"
            name="Trigger Licence Reissue"/>

        <bpmn:endEvent id="complete"/>

        <bpmn:sequenceFlow
            id="f1"
            sourceRef="start"
            targetRef="send_confirmation"/>

        <bpmn:sequenceFlow
            id="f2"
            sourceRef="send_confirmation"
            targetRef="trigger_reissue"/>

        <bpmn:sequenceFlow
            id="f3"
            sourceRef="trigger_reissue"
            targetRef="complete"/>

    </bpmn:process>

</bpmn:definitions>