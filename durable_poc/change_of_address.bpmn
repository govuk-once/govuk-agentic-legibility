<?xml version="1.0" encoding="UTF-8"?>

<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:meta="urn:durable-workflow:metadata:v1"
    targetNamespace="urn:durable-workflow:processes:v1"
    id="dvla_change_address">

    <!-- ====================================================== -->
    <!-- Errors                                                   -->
    <!-- ====================================================== -->

    <bpmn:error id="ApiFailure" name="ApiFailure"/>
    <bpmn:error id="InvalidPhoto" name="InvalidPhoto"/>
    <bpmn:error id="InvalidAddress" name="InvalidAddress"/>
    <bpmn:error id="Ineligible" name="Ineligible"/>
    <bpmn:error id="DeliveryFailure" name="DeliveryFailure"/>

    <!-- ====================================================== -->
    <!-- Main Process                                             -->
    <!-- ====================================================== -->

    <bpmn:process
        id="change_address"
        name="Driving Licence Change Of Address"
        isExecutable="true">

        <bpmn:extensionElements>

            <meta:workflowMetadata
                name="Driving Licence Change Of Address"
                version="2.0.0"/>

        </bpmn:extensionElements>

        <!-- ================================================== -->
        <!-- Events                                              -->
        <!-- ================================================== -->

        <bpmn:startEvent
            id="start"
            name="Start">
            <bpmn:outgoing>f1</bpmn:outgoing>
        </bpmn:startEvent>

        <!-- ================================================== -->
        <!-- Confirm Intent                                      -->
        <!-- ================================================== -->

        <bpmn:userTask
            id="confirm_intent"
            name="Confirm Intent">

            <bpmn:extensionElements>

                <meta:taskHandler type="form"/>

                <meta:form title="Change Address Confirmation">

                    <meta:field
                        id="confirmed"
                        variable="confirmed"
                        label="Would you like to update the address on your driving licence?"
                        type="boolean"
                        required="true"/>

                </meta:form>

            </bpmn:extensionElements>

            <bpmn:incoming>f1</bpmn:incoming>
            <bpmn:outgoing>f2</bpmn:outgoing>

        </bpmn:userTask>

        <bpmn:exclusiveGateway
            id="intent_gateway"
            name="Continue Journey?"
            default="f_cancel">

            <bpmn:incoming>f2</bpmn:incoming>
            <bpmn:outgoing>f_continue</bpmn:outgoing>
            <bpmn:outgoing>f_cancel</bpmn:outgoing>

        </bpmn:exclusiveGateway>

        <!-- ================================================== -->
        <!-- Eligibility Check                                   -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_eligibility"
            name="Eligibility Check"
            calledElement="eligibility_check">

            <bpmn:extensionElements>

                <meta:output assign="eligibility"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f_continue</bpmn:incoming>
            <bpmn:outgoing>f3</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="eligibility_failed"
            attachedToRef="run_eligibility"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="Ineligible"/>

            <bpmn:outgoing>f_ineligible</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Driver Lookup                                       -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_driver_lookup"
            name="Verify Driver"
            calledElement="driver_lookup">

            <bpmn:extensionElements>

                <meta:output assign="driver_info"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f3</bpmn:incoming>
            <bpmn:outgoing>f4</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="driver_lookup_error"
            attachedToRef="run_driver_lookup"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>f_manual_1</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Photo Journey                                       -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_photo_capture"
            name="Photo Journey"
            calledElement="photo_capture">

            <bpmn:extensionElements>

                <meta:input
                    source="driver_info.driver_id"
                    target="driver_id"/>

                <meta:output
                    assign="photo_id"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f4</bpmn:incoming>
            <bpmn:outgoing>f5</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="photo_invalid"
            attachedToRef="run_photo_capture"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="InvalidPhoto"/>

            <bpmn:outgoing>f_rejected_1</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <bpmn:boundaryEvent
            id="photo_api_error"
            attachedToRef="run_photo_capture"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>f_manual_2</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Address Selection                                   -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_address_selection"
            name="Select Address"
            calledElement="address_selection">

            <bpmn:extensionElements>

                <meta:output assign="address"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f5</bpmn:incoming>
            <bpmn:outgoing>f6</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="address_selection_error"
            attachedToRef="run_address_selection"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>f_manual_3</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Address Update                                      -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_address_update"
            name="Submit Address Change"
            calledElement="address_update">

            <bpmn:extensionElements>

                <meta:input
                    source="driver_info.driver_id"
                    target="driver_id"/>

                <meta:input
                    source="address"
                    target="address"/>

                <meta:input
                    source="photo_id"
                    target="photo_id"/>

                <meta:output
                    assign="update_result"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f6</bpmn:incoming>
            <bpmn:outgoing>f7</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="address_invalid"
            attachedToRef="run_address_update"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="InvalidAddress"/>

            <bpmn:outgoing>f_rejected_2</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <bpmn:boundaryEvent
            id="address_update_error"
            attachedToRef="run_address_update"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>f_manual_4</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Finalisation                                        -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_finalisation"
            name="Finalisation"
            calledElement="finalisation">

            <bpmn:extensionElements>

                <meta:input
                    source="driver_info.driver_id"
                    target="driver_id"/>

                <meta:input
                    source="driver_info.email"
                    target="email"/>

                <meta:input
                    source="address"
                    target="address"/>

                <meta:input
                    source="update_result.job_id"
                    target="job_id"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f7</bpmn:incoming>
            <bpmn:outgoing>f8</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="finalisation_error"
            attachedToRef="run_finalisation"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="DeliveryFailure"/>

            <bpmn:outgoing>f_manual_5</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Manual Review                                       -->
        <!-- ================================================== -->

        <bpmn:manualTask
            id="manual_review"
            name="Manual Review">

            <bpmn:extensionElements>

                <meta:taskHandler type="manual"/>

                <meta:manualReview
                    queue="dvla-review"
                    priority="high"
                    category="address-change"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f_manual_1</bpmn:incoming>
            <bpmn:incoming>f_manual_2</bpmn:incoming>
            <bpmn:incoming>f_manual_3</bpmn:incoming>
            <bpmn:incoming>f_manual_4</bpmn:incoming>
            <bpmn:incoming>f_manual_5</bpmn:incoming>

            <bpmn:outgoing>f_manual_complete</bpmn:outgoing>

        </bpmn:manualTask>

        <!-- ================================================== -->
        <!-- End Events                                          -->
        <!-- ================================================== -->

        <bpmn:endEvent
            id="end_success"
            name="Address Updated">
            <bpmn:incoming>f8</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:endEvent
            id="end_cancelled"
            name="Journey Cancelled">
            <bpmn:incoming>f_cancel</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:endEvent
            id="end_ineligible"
            name="Not Eligible">
            <bpmn:incoming>f_ineligible</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:endEvent
            id="end_rejected"
            name="Request Rejected">
            <bpmn:incoming>f_rejected_1</bpmn:incoming>
            <bpmn:incoming>f_rejected_2</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:endEvent
            id="end_manual_review"
            name="Transferred To Manual Processing">
            <bpmn:incoming>f_manual_complete</bpmn:incoming>
        </bpmn:endEvent>

        <!-- ================================================== -->
        <!-- Sequence Flows                                      -->
        <!-- ================================================== -->

        <bpmn:sequenceFlow
            id="f1"
            sourceRef="start"
            targetRef="confirm_intent"/>

        <bpmn:sequenceFlow
            id="f2"
            sourceRef="confirm_intent"
            targetRef="intent_gateway"/>

        <bpmn:sequenceFlow
            id="f_continue"
            sourceRef="intent_gateway"
            targetRef="run_eligibility">

            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
                bool(confirmed)
            </bpmn:conditionExpression>

        </bpmn:sequenceFlow>

        <bpmn:sequenceFlow
            id="f_cancel"
            sourceRef="intent_gateway"
            targetRef="end_cancelled"/>

        <bpmn:sequenceFlow
            id="f3"
            sourceRef="run_eligibility"
            targetRef="run_driver_lookup"/>

        <bpmn:sequenceFlow
            id="f4"
            sourceRef="run_driver_lookup"
            targetRef="run_photo_capture"/>

        <bpmn:sequenceFlow
            id="f5"
            sourceRef="run_photo_capture"
            targetRef="run_address_selection"/>

        <bpmn:sequenceFlow
            id="f6"
            sourceRef="run_address_selection"
            targetRef="run_address_update"/>

        <bpmn:sequenceFlow
            id="f7"
            sourceRef="run_address_update"
            targetRef="run_finalisation"/>

        <bpmn:sequenceFlow
            id="f8"
            sourceRef="run_finalisation"
            targetRef="end_success"/>

        <bpmn:sequenceFlow
            id="f_ineligible"
            sourceRef="eligibility_failed"
            targetRef="end_ineligible"/>

        <bpmn:sequenceFlow
            id="f_rejected_1"
            sourceRef="photo_invalid"
            targetRef="end_rejected"/>

        <bpmn:sequenceFlow
            id="f_rejected_2"
            sourceRef="address_invalid"
            targetRef="end_rejected"/>

        <bpmn:sequenceFlow
            id="f_manual_1"
            sourceRef="driver_lookup_error"
            targetRef="manual_review"/>

        <bpmn:sequenceFlow
            id="f_manual_2"
            sourceRef="photo_api_error"
            targetRef="manual_review"/>

        <bpmn:sequenceFlow
            id="f_manual_3"
            sourceRef="address_selection_error"
            targetRef="manual_review"/>

        <bpmn:sequenceFlow
            id="f_manual_4"
            sourceRef="address_update_error"
            targetRef="manual_review"/>

        <bpmn:sequenceFlow
            id="f_manual_5"
            sourceRef="finalisation_error"
            targetRef="manual_review"/>

        <bpmn:sequenceFlow
            id="f_manual_complete"
            sourceRef="manual_review"
            targetRef="end_manual_review"/>

    </bpmn:process>

</bpmn:definitions>