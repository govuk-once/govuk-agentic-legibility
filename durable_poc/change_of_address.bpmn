<?xml version="1.0" encoding="UTF-8"?>

<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:meta="urn:durable-workflow:metadata:v1"
    targetNamespace="urn:durable-workflow:processes:v1"
    id="dvla_change_address">

    <!-- ====================================================== -->
    <!-- Errors                                                   -->
    <!-- ====================================================== -->

    <bpmn:error id="ApiFailure" name="ApiFailure"/>
    <bpmn:error id="InvalidPhoto" name="InvalidPhoto"/>
    <bpmn:error id="InvalidSignature" name="InvalidSignature"/>
    <bpmn:error id="InvalidAddress" name="InvalidAddress"/>
    <bpmn:error id="DeliveryFailure" name="DeliveryFailure"/>
    <bpmn:error id="UserCancelled" name="UserCancelled"/>
    <bpmn:error id="PostalApplicationRequired" name="PostalApplicationRequired"/>

    <!-- ====================================================== -->
    <!-- Main Process                                             -->
    <!-- ====================================================== -->

    <bpmn:process
        id="change_address"
        name="Driving Licence Change Of Address"
        isExecutable="true">

        <bpmn:extensionElements>

            <meta:workflowMetadata
                name="Driving Licence Change Of Address"
                version="1.0.0"/>

        </bpmn:extensionElements>

        <!-- ================================================== -->
        <!-- Events                                              -->
        <!-- ================================================== -->

        <bpmn:startEvent
            id="start"
            name="Start">
            <bpmn:outgoing>f1</bpmn:outgoing>
        </bpmn:startEvent>

        <!-- ================================================== -->
        <!-- Confirm Intent                                      -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_confirm_intent"
            name="Confirm Intent"
            calledElement="confirm_intent">

            <bpmn:extensionElements>

                <meta:validateOutputs enabled="true"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f1</bpmn:incoming>
            <bpmn:outgoing>f2</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="confirm_cancelled"
            attachedToRef="run_confirm_intent"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="UserCancelled"/>

            <bpmn:outgoing>f_cancel</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Name Check                                   -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_name_change_check"
            name="Name Change Check"
            calledElement="name_change_check">

            <bpmn:extensionElements>

                <meta:validateOutputs enabled="true"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f2</bpmn:incoming>
            <bpmn:outgoing>f3</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="postal_required"
            attachedToRef="run_name_change_check"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="PostalApplicationRequired"/>

            <bpmn:outgoing>
                f_postal_required
            </bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Driver Lookup                                       -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_driver_lookup"
            name="Verify Driver"
            calledElement="driver_lookup">

            <bpmn:extensionElements>

                <meta:validateInputs enabled="true"/>
                <meta:validateOutputs enabled="true"/>

                <meta:output
                    source="driver_id"
                    target="driver_id"/>

                <meta:output
                    source="email"
                    target="email"/>

                <meta:output
                    source="current_address"
                    target="current_address"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f3</bpmn:incoming>
            <bpmn:outgoing>f4</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="driver_lookup_error"
            attachedToRef="run_driver_lookup"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>f_exception_1</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Photo Journey                                       -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_photo_update"
            name="Photo Journey"
            calledElement="photo_update">

            <bpmn:extensionElements>

                <meta:validateInputs enabled="true"/>
                <meta:validateOutputs enabled="true"/>

                <meta:input
                    source="driver_id"
                    target="driver_id"/>

                <meta:output
                    source="photo_id"
                    target="photo_id"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f4</bpmn:incoming>
            <bpmn:outgoing>f5</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="photo_invalid"
            attachedToRef="run_photo_update"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="InvalidPhoto"/>

            <bpmn:outgoing>f_rejected_2</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <bpmn:boundaryEvent
            id="photo_api_error"
            attachedToRef="run_photo_update"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>f_exception_2</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Signature Journey                                       -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_signature_update"
            name="Signature Update"
            calledElement="signature_update">

            <bpmn:extensionElements>

                <meta:validateInputs enabled="true"/>
                <meta:validateOutputs enabled="true"/>

                <meta:input
                    source="driver_id"
                    target="driver_id"/>

                <meta:output
                    source="signature_id"
                    target="signature_id"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f5</bpmn:incoming>
            <bpmn:outgoing>f6</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="signature_invalid"
            attachedToRef="run_signature_update"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="InvalidSignature"/>

            <bpmn:outgoing>
                f_rejected_1
            </bpmn:outgoing>

        </bpmn:boundaryEvent>

        <bpmn:boundaryEvent
            id="signature_api_error"
            attachedToRef="run_signature_update"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>
                f_exception_3
            </bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Organ Journey                                       -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_organ_donation"
            name="Organ Donation"
            calledElement="organ_donation">

            <bpmn:extensionElements>

                <meta:validateInputs enabled="true"/>
                <meta:validateOutputs enabled="true"/>

                <meta:input
                    source="driver_id"
                    target="driver_id"/>

                <meta:output
                    source="organ_consent"
                    target="organ_consent"/>

            </bpmn:extensionElements>
            
            <bpmn:incoming>f6</bpmn:incoming>
            <bpmn:outgoing>f7</bpmn:outgoing>

        </bpmn:callActivity>

        <!-- ================================================== -->
        <!-- Address Selection                                   -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_address_selection"
            name="Select Address"
            calledElement="address_selection">

            <bpmn:extensionElements>

                <meta:validateInputs enabled="true"/>
                <meta:validateOutputs enabled="true"/>

                <meta:output
                    source="address"
                    target="address"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f7</bpmn:incoming>
            <bpmn:outgoing>f8</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="address_selection_error"
            attachedToRef="run_address_selection"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>f_exception_3</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Address Update                                      -->
        <!-- ================================================== -->

        <bpmn:scriptTask
            id="validate_submission"
            name="Validate Submission">

            <bpmn:incoming>f8</bpmn:incoming>
            <bpmn:outgoing>f9</bpmn:outgoing>

            <bpmn:extensionElements>

                <meta:taskHandler type="validation"/>

                <meta:validationRules>

                    <meta:rule
                        expression="driver_id is not None and driver_id != ''"
                        message="Driver ID missing"/>

                    <meta:rule
                        expression="photo_id is not None and photo_id != ''"
                        message="Photo ID missing"/>

                    <meta:rule
                        expression="address is not None"
                        message="Address missing"/>

                    <meta:rule
                        expression="signature_id is not None and signature_id != ''"
                        message="Signature ID missing"/>

                </meta:validationRules>

            </bpmn:extensionElements>

        </bpmn:scriptTask>

        <bpmn:callActivity
            id="run_address_update"
            name="Submit Address Change"
            calledElement="address_update">

            <bpmn:extensionElements>

                <meta:validateInputs enabled="true"/>
                <meta:validateOutputs enabled="true"/>

                <meta:input
                    source="driver_id"
                    target="driver_id"/>

                <meta:input
                    source="address"
                    target="address"/>

                <meta:input
                    source="photo_id"
                    target="photo_id"/>

                <meta:input
                    source="signature_id"
                    target="signature_id"/>

                <meta:output
                    source="job_id"
                    target="job_id"/>

                <meta:output
                    source="status"
                    target="status"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f9</bpmn:incoming>
            <bpmn:outgoing>f10</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="address_invalid"
            attachedToRef="run_address_update"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="InvalidAddress"/>

            <bpmn:outgoing>f_rejected_3</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <bpmn:boundaryEvent
            id="address_update_error"
            attachedToRef="run_address_update"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>f_exception_4</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Finalisation                                        -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_finalisation"
            name="Finalisation"
            calledElement="finalisation">

            <bpmn:extensionElements>

                <meta:validateInputs enabled="true"/>
                <meta:validateOutputs enabled="true"/>

                <meta:input
                    source="driver_id"
                    target="driver_id"/>

                <meta:input
                    source="email"
                    target="email"/>

                <meta:input
                    source="address"
                    target="address"/>

                <meta:input
                    source="job_id"
                    target="job_id"/>

                <meta:input
                    source="organ_consent"
                    target="organ_consent"/>

                <meta:output
                    source="confirmation_sent"
                    target="confirmation_sent"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f10</bpmn:incoming>
            <bpmn:outgoing>f11</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="finalisation_error"
            attachedToRef="run_finalisation"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="DeliveryFailure"/>

            <bpmn:outgoing>f_exception_5</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- End Events                                          -->
        <!-- ================================================== -->

        <bpmn:endEvent
            id="end_success"
            name="Address Updated">
            <bpmn:incoming>f11</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:endEvent
            id="end_cancelled"
            name="Journey Cancelled">
            <bpmn:incoming>f_cancel</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:endEvent
            id="end_rejected"
            name="Request Rejected">
            <bpmn:incoming>f_rejected_1</bpmn:incoming>
            <bpmn:incoming>f_rejected_2</bpmn:incoming>
            <bpmn:incoming>f_rejected_3</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:endEvent
            id="end_postal_required"
            name="Postal Application Required">

            <bpmn:incoming>
                f_postal_required
            </bpmn:incoming>

        </bpmn:endEvent>

        <bpmn:endEvent
            id="end_exception"
            name="Journey Failed">

            <bpmn:incoming>f_exception_1</bpmn:incoming>
            <bpmn:incoming>f_exception_2</bpmn:incoming>
            <bpmn:incoming>f_exception_3</bpmn:incoming>
            <bpmn:incoming>f_exception_4</bpmn:incoming>
            <bpmn:incoming>f_exception_5</bpmn:incoming>
            <bpmn:incoming>f_exception_6</bpmn:incoming>

        </bpmn:endEvent>

        <!-- ================================================== -->
        <!-- Sequence Flows                                      -->
        <!-- ================================================== -->

        <bpmn:sequenceFlow
            id="f1"
            sourceRef="start"
            targetRef="run_confirm_intent"/>

        <bpmn:sequenceFlow
            id="f2"
            sourceRef="run_confirm_intent"
            targetRef="run_name_change_check"/>

        <bpmn:sequenceFlow
            id="f3"
            sourceRef="run_name_change_check"
            targetRef="run_driver_lookup"/>

        <bpmn:sequenceFlow
            id="f4"
            sourceRef="run_driver_lookup"
            targetRef="run_photo_update"/>

        <bpmn:sequenceFlow
            id="f5"
            sourceRef="run_photo_update"
            targetRef="run_signature_update"/>

        <bpmn:sequenceFlow
            id="f6"
            sourceRef="run_signature_update"
            targetRef="run_organ_donation"/>
        
        <bpmn:sequenceFlow
            id="f7"
            sourceRef="run_organ_donation"
            targetRef="run_address_selection"/>

        <bpmn:sequenceFlow
            id="f8"
            sourceRef="run_address_selection"
            targetRef="validate_submission"/>

        <bpmn:sequenceFlow
            id="f9"
            sourceRef="validate_submission"
            targetRef="run_address_update"/>

        <bpmn:sequenceFlow
            id="f10"
            sourceRef="run_address_update"
            targetRef="run_finalisation"/>

        <bpmn:sequenceFlow
            id="f11"
            sourceRef="run_finalisation"
            targetRef="end_success"/>

        <bpmn:sequenceFlow
            id="f_rejected_1"
            sourceRef="signature_invalid"
            targetRef="end_rejected"/>

        <bpmn:sequenceFlow
            id="f_rejected_2"
            sourceRef="photo_invalid"
            targetRef="end_rejected"/>

        <bpmn:sequenceFlow
            id="f_rejected_3"
            sourceRef="address_invalid"
            targetRef="end_rejected"/>

        <bpmn:sequenceFlow
            id="f_exception_1"
            sourceRef="driver_lookup_error"
            targetRef="end_exception"/>

        <bpmn:sequenceFlow
            id="f_exception_2"
            sourceRef="photo_api_error"
            targetRef="end_exception"/>
        
        <bpmn:sequenceFlow
            id="f_exception_3"
            sourceRef="signature_api_error"
            targetRef="end_exception"/>

        <bpmn:sequenceFlow
            id="f_exception_4"
            sourceRef="address_selection_error"
            targetRef="end_exception"/>

        <bpmn:sequenceFlow
            id="f_exception_5"
            sourceRef="address_update_error"
            targetRef="end_exception"/>

        <bpmn:sequenceFlow
            id="f_exception_6"
            sourceRef="finalisation_error"
            targetRef="end_exception"/>
        
    </bpmn:process>

</bpmn:definitions>