<?xml version="1.0" encoding="UTF-8"?>

<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:meta="urn:durable-workflow:metadata:v1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <bpmn:error
        id="ApiFailure"
        name="ApiFailure"/>

    <bpmn:process
        id="driver_lookup"
        name="Driver Lookup"
        isExecutable="true">

        <bpmn:extensionElements>

            <meta:workflowMetadata
                name="Driver Lookup"
                version="1.0.0"/>

            <meta:processContract>

                <meta:output
                    name="driver_id"
                    type="string"
                    required="true"/>

                <meta:output
                    name="email"
                    type="string"
                    required="true"/>

                <meta:output
                    name="current_address"
                    type="object"
                    required="true"/>

            </meta:processContract>

        </bpmn:extensionElements>

        <!-- ================================================== -->
        <!-- Start                                              -->
        <!-- ================================================== -->

        <bpmn:startEvent id="start">
            <bpmn:outgoing>f1</bpmn:outgoing>
        </bpmn:startEvent>

        <!-- ================================================== -->
        <!-- Lookup Driver                                      -->
        <!-- ================================================== -->

        <bpmn:serviceTask
            id="lookup_driver"
            name="Lookup Driver">

            <bpmn:incoming>f1</bpmn:incoming>
            <bpmn:outgoing>f2</bpmn:outgoing>

            <bpmn:extensionElements>

                <meta:taskHandler type="http"/>

                <meta:httpService
                    method="GET"
                    service="dvla"
                    endpoint="/app/dvla/v1/driver-summary">

                    <meta:retry
                        attempts="3"
                        backoffSeconds="5"/>

                    <meta:timeout
                        duration="PT30S"/>

                    <meta:output
                        source="response.body.driverViewResponse.driver.drivingLicenceNumber"
                        target="driver_id"/>

                    <meta:output
                        source="response.body.driverViewResponse.driver.firstNames"
                        target="first_names"/>

                    <meta:output
                        source="response.body.driverViewResponse.driver.lastName"
                        target="last_name"/>

                    <meta:output
                        source="response.body.driverViewResponse.driver.dateOfBirth"
                        target="dob"/>

                    <meta:output
                        source="response.body.driverViewResponse.driver.email"
                        target="email"/>

                    <meta:output
                        source="response.body.driverViewResponse.driver.address.unstructuredAddress"
                        target="current_address"/>

                </meta:httpService>

            </bpmn:extensionElements>

        </bpmn:serviceTask>

        <!-- ================================================== -->
        <!-- API Failure                                        -->
        <!-- ================================================== -->

        <bpmn:boundaryEvent
            id="driver_lookup_error"
            attachedToRef="lookup_driver"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>f_api_error</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Confirm Details                                    -->
        <!-- ================================================== -->

        <bpmn:userTask
            id="confirm_details"
            name="Confirm Driver Details">

            <bpmn:incoming>f2</bpmn:incoming>
            <bpmn:outgoing>f3</bpmn:outgoing>

            <bpmn:extensionElements>

                <meta:taskHandler type="form"/>

                <meta:form
                    title="Confirm Driver Details">

                    <meta:field
                        id="details_confirmed"
                        variable="details_confirmed"
                        type="boolean"
                        required="true"
                        label="Are these details correct?"/>

                </meta:form>

            </bpmn:extensionElements>

        </bpmn:userTask>

        <!-- ================================================== -->
        <!-- Confirmation Gateway                              -->
        <!-- ================================================== -->

        <bpmn:exclusiveGateway
            id="confirmation_gateway"
            default="f_manual">

            <bpmn:incoming>f3</bpmn:incoming>

            <bpmn:outgoing>f_confirmed</bpmn:outgoing>
            <bpmn:outgoing>f_manual</bpmn:outgoing>

        </bpmn:exclusiveGateway>

        <!-- ================================================== -->
        <!-- Manual Correction                                  -->
        <!-- ================================================== -->

        <bpmn:userTask
            id="correct_details"
            name="Correct Driver Details">

            <bpmn:incoming>f_manual</bpmn:incoming>
            <bpmn:outgoing>f_manual_complete</bpmn:outgoing>

            <bpmn:extensionElements>

                <meta:taskHandler type="form"/>

                <meta:form
                    title="Correct Driver Details">

                    <meta:field
                        id="first_names"
                        variable="first_names"
                        type="string"
                        required="true"
                        label="First Names"/>

                    <meta:field
                        id="last_name"
                        variable="last_name"
                        type="string"
                        required="true"
                        label="Last Name"/>

                    <meta:field
                        id="dob"
                        variable="dob"
                        type="date"
                        required="true"
                        label="Date of Birth"/>

                    <meta:field
                        id="email"
                        variable="email"
                        type="string"
                        required="true"
                        label="Email"/>

                    <meta:field
                        id="driver_id"
                        variable="driver_id"
                        type="string"
                        required="true"
                        label="Driving Licence Number"/>

                </meta:form>

            </bpmn:extensionElements>

        </bpmn:userTask>

        <!-- ================================================== -->
        <!-- Success                                            -->
        <!-- ================================================== -->

        <bpmn:endEvent
            id="success">

            <bpmn:incoming>f_confirmed</bpmn:incoming>
            <bpmn:incoming>f_manual_complete</bpmn:incoming>

        </bpmn:endEvent>

        <!-- ================================================== -->
        <!-- API Failure End                                    -->
        <!-- ================================================== -->

        <bpmn:endEvent
            id="api_failure_end">

            <bpmn:incoming>f_api_error</bpmn:incoming>

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

        </bpmn:endEvent>

        <!-- ================================================== -->
        <!-- Sequence Flows                                     -->
        <!-- ================================================== -->

        <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="lookup_driver"/>
        <bpmn:sequenceFlow id="f2" sourceRef="lookup_driver" targetRef="confirm_details"/>
        <bpmn:sequenceFlow id="f3" sourceRef="confirm_details" targetRef="confirmation_gateway"/>

        <bpmn:sequenceFlow
            id="f_confirmed"
            sourceRef="confirmation_gateway"
            targetRef="success">

            <bpmn:conditionExpression
                xsi:type="bpmn:tFormalExpression">

                details_confirmed == true

            </bpmn:conditionExpression>

        </bpmn:sequenceFlow>

        <bpmn:sequenceFlow id="f_manual" sourceRef="confirmation_gateway" targetRef="correct_details"/>

        <bpmn:sequenceFlow
            id="f_manual_complete"
            sourceRef="correct_details"
            targetRef="success"/>

        <bpmn:sequenceFlow
            id="f_api_error"
            sourceRef="driver_lookup_error"
            targetRef="api_failure_end"/>

    </bpmn:process>

</bpmn:definitions>