<?xml version="1.0" encoding="UTF-8"?>

<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:meta="urn:durable-workflow:metadata:v1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <bpmn:error id="Ineligible" name="Ineligible"/>

    <bpmn:process
        id="eligibility_check"
        name="Eligibility Check"
        isExecutable="true">

        <bpmn:extensionElements>

            <meta:processContract/>

        </bpmn:extensionElements>

        <bpmn:startEvent id="start">

            <bpmn:outgoing>f1</bpmn:outgoing>

        </bpmn:startEvent>

        <bpmn:userTask
            id="confirm_uk_resident"
            name="Confirm UK Residency">

            <bpmn:incoming>f1</bpmn:incoming>
            <bpmn:outgoing>f2</bpmn:outgoing>

            <bpmn:extensionElements>

                <meta:taskHandler type="form"/>

                <meta:form title="Eligibility Check">

                    <meta:field
                        id="uk_resident"
                        variable="uk_resident"
                        label="Do you currently live in Great Britain?"
                        type="boolean"
                        required="true">

                        <meta:validation
                            rule="uk_resident is not None"
                            message="Please answer the eligibility question"/>

                    </meta:field>

                </meta:form>

            </bpmn:extensionElements>

        </bpmn:userTask>

        <bpmn:exclusiveGateway
            id="eligibility_gateway"
            default="ineligible_flow">

            <bpmn:incoming>f2</bpmn:incoming>

            <bpmn:outgoing>eligible_flow</bpmn:outgoing>
            <bpmn:outgoing>ineligible_flow</bpmn:outgoing>

        </bpmn:exclusiveGateway>

        <bpmn:endEvent id="eligible">

            <bpmn:incoming>eligible_flow</bpmn:incoming>

        </bpmn:endEvent>

        <bpmn:endEvent id="ineligible">

            <bpmn:incoming>ineligible_flow</bpmn:incoming>

            <bpmn:errorEventDefinition
                errorRef="Ineligible"/>

        </bpmn:endEvent>

        <bpmn:sequenceFlow
            id="f1"
            sourceRef="start"
            targetRef="confirm_uk_resident"/>

        <bpmn:sequenceFlow
            id="f2"
            sourceRef="confirm_uk_resident"
            targetRef="eligibility_gateway"/>

        <bpmn:sequenceFlow
            id="eligible_flow"
            sourceRef="eligibility_gateway"
            targetRef="eligible">

            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
                bool(uk_resident)
            </bpmn:conditionExpression>

        </bpmn:sequenceFlow>

        <bpmn:sequenceFlow
            id="ineligible_flow"
            sourceRef="eligibility_gateway"
            targetRef="ineligible"/>

    </bpmn:process>

</bpmn:definitions>