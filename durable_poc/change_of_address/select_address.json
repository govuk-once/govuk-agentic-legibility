{
    "process_id": "select_address",
    "version": "0.1.0",
    "start": "choose_entry_method",
    "vars": {
        "entry_method": null,
        "postcode": null,
        "postcode_attempts": 0,
        "addresses": null,
        "selected_address": null,
        "manual_address": null,
        "manual_postcode": null
    },
    "states": {
        "choose_entry_method": {
            "type": "input",
            "prompt": "How would you like to enter your new address?",
            "schema": {
                "kind": "select_one",
                "options": [
                    {
                        "value": "1",
                        "label": "Search by Postcode"
                    },
                    {
                        "value": "2",
                        "label": "Enter Address Manually"
                    }
                ]
            },
            "assign": "entry_method",
            "next": "branch_method"
        },
        "branch_method": {
            "type": "choice",
            "rules": [
                {
                    "when": {
                        "op": "eq",
                        "path": "entry_method",
                        "value": "2"
                    },
                    "next": "prompt_manual_address"
                }
            ],
            "default": "prompt_postcode"
        },
        "prompt_postcode": {
            "type": "input",
            "prompt": "Enter your new UK postcode:",
            "schema": {
                "kind": "string",
                "pattern": "^[A-Z]{1,2}\\d[A-Z\\d]?\\s*\\d[A-Z]{2}$",
                "normalise": "upper_trim",
                "invalid_message": "That doesn't look like a UK postcode."
            },
            "assign": "postcode",
            "on_invalid": "increment_postcode_attempts",
            "next": "lookup_postcode"
        },
        "increment_postcode_attempts": {
            "type": "assign",
            "set": {
                "postcode_attempts": {
                    "op": "add",
                    "path": "postcode_attempts",
                    "value": 1
                }
            },
            "next": "check_postcode_retry_limit"
        },
        "check_postcode_retry_limit": {
            "type": "choice",
            "rules": [
                {
                    "when": {
                        "op": "gte",
                        "path": "postcode_attempts",
                        "value": 3
                    },
                    "next": "say_max_postcode_attempts"
                }
            ],
            "default": "prompt_postcode"
        },
        "say_max_postcode_attempts": {
            "type": "output",
            "channel": "transcript",
            "message": "Maximum postcode entry attempts exceeded. Please enter your address manually.",
            "next": "prompt_manual_address"
        },
        "lookup_postcode": {
            "type": "call",
            "method": "POST",
            "service": "postoffice",
            "url": "/app/postoffice/v1/address_from_postcode",
            "body": {
                "postcode": {
                    "$": "postcode"
                }
            },
            "idempotency_key": "{{workflow_id}}:address_lookup_{{postcode}}",
            "assign": "addresses",
            "capture": {
                "addresses": "body.addresses"
            },
            "catch": [
                {
                    "on": "any",
                    "next": "end_api_failure"
                }
            ],
            "next": "prompt_select_address"
        },
        "prompt_select_address": {
            "type": "input",
            "prompt": "Select your address:",
            "schema": {
                "kind": "select_one",
                "options_from": "addresses.addresses",
                "value_key": "single_line",
                "label_key": "single_line"
            },
            "assign": "selected_address",
            "next": "end_success_selected"
        },
        "prompt_manual_address": {
            "type": "input",
            "prompt": "Enter Address Line 1 (e.g., 10 Downing Street):",
            "schema": {
                "kind": "string",
                "pattern": "^[a-zA-Z0-9\\s,.'-]{3,100}$",
                "normalise": "trim",
                "invalid_message": "Please enter a valid street address (between 3 and 100 characters)."
            },
            "assign": "manual_address",
            "next": "prompt_manual_postcode"
        },
        "prompt_manual_postcode": {
            "type": "input",
            "prompt": "Enter your UK postcode:",
            "schema": {
                "kind": "string",
                "pattern": "^[A-Z]{1,2}\\d[A-Z\\d]?\\s*\\d[A-Z]{2}$",
                "normalise": "upper_trim",
                "invalid_message": "That doesn't look like a valid UK postcode."
            },
            "assign": "manual_postcode",
            "next": "end_success_manual"
        },
        "end_success_selected": {
            "type": "end",
            "status": "success",
            "outcome": "address_selected",
            "return": {
                "single_line": {
                    "$": "selected_address.line1"
                },
                "postcode": {
                    "$": "postcode"
                }
            }
        },
        "end_success_manual": {
            "type": "end",
            "status": "success",
            "outcome": "address_entered_manually",
            "return": {
                "single_line": {
                    "$": "manual_address"
                },
                "postcode": {
                    "$": "manual_postcode"
                }
            }
        },
        "end_api_failure": {
            "type": "end",
            "status": "failed",
            "outcome": "api_failure"
        }
    }
}