<?xml version="1.0" encoding="UTF-8"?>

<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:meta="urn:durable-workflow:metadata:v1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    targetNamespace="urn:durable-workflow:processes:v1"
    id="finalisation_definition">

    <!-- ===================================================== -->
    <!-- Errors                                                -->
    <!-- ===================================================== -->

    <bpmn:error
        id="DeliveryFailure"
        name="DeliveryFailure"/>

    <!-- ===================================================== -->
    <!-- Process                                               -->
    <!-- ===================================================== -->

    <bpmn:process
        id="finalisation"
        name="Finalisation"
        isExecutable="true">

        <bpmn:extensionElements>

            <meta:workflowMetadata
                name="Finalisation"
                version="1.0.0"/>

            <meta:processContract>

                <meta:input
                    name="driver_id"
                    type="string"
                    required="true"/>

                <meta:input
                    name="email"
                    type="string"
                    required="true"/>

                <meta:input
                    name="address"
                    type="object"
                    required="true"/>

                <meta:input
                    name="job_id"
                    type="string"
                    required="true"/>

                <meta:input
                    name="organ_consent"
                    type="boolean"
                    required="false"/>

                <meta:output
                    name="confirmation_sent"
                    type="boolean"
                    required="true"/>

            </meta:processContract>

        </bpmn:extensionElements>

        <!-- ================================================== -->
        <!-- Start                                              -->
        <!-- ================================================== -->

        <bpmn:startEvent id="start">

            <bpmn:outgoing>f1</bpmn:outgoing>

        </bpmn:startEvent>

        <!-- ================================================== -->
        <!-- Send Confirmation                                  -->
        <!-- ================================================== -->

        <bpmn:scriptTask
            id="send_confirmation"
            name="Send Confirmation">

            <bpmn:incoming>f1</bpmn:incoming>
            <bpmn:outgoing>f2</bpmn:outgoing>

            <bpmn:extensionElements>

                <meta:taskHandler type="notification"/>

                <meta:notification
                    channel="email">

                    <meta:output
                        source="true"
                        target="confirmation_sent"/>

                </meta:notification>

            </bpmn:extensionElements>

        </bpmn:scriptTask>

        <!-- ================================================== -->
        <!-- Submission Complete Message                        -->
        <!-- ================================================== -->

        <bpmn:sendTask
            id="submission_complete"
            name="Application Submitted">

            <bpmn:incoming>f2</bpmn:incoming>
            <bpmn:outgoing>f3</bpmn:outgoing>

            <bpmn:extensionElements>

                <meta:taskHandler type="message"/>

                <meta:message
                    severity="success"
                    title="Application Submitted">

                    <meta:text>
                        Your driving licence update has been submitted successfully. \nA confirmation email has been sent to your registered email address, ${email}. \nYour updated driving licence has been dispatched and should arrive within 5 working days. \nReference: ${job_id}
                    </meta:text>

                </meta:message>

            </bpmn:extensionElements>

        </bpmn:sendTask>

        <!-- ================================================== -->
        <!-- Wait For Delivery                                  -->
        <!-- ================================================== -->

        <bpmn:intermediateCatchEvent
            id="wait_for_delivery"
            name="Delivery Wait">

            <bpmn:incoming>f3</bpmn:incoming>
            <bpmn:outgoing>f4</bpmn:outgoing>

            <bpmn:timerEventDefinition>

                <bpmn:timeDuration>
                    PT10S
                </bpmn:timeDuration>

            </bpmn:timerEventDefinition>

        </bpmn:intermediateCatchEvent>

        <!-- ================================================== -->
        <!-- Confirm Receipt                                    -->
        <!-- ================================================== -->

        <bpmn:userTask
            id="confirm_receipt"
            name="Confirm Licence Receipt">

            <bpmn:incoming>f4</bpmn:incoming>
            <bpmn:outgoing>f5</bpmn:outgoing>

            <bpmn:extensionElements>

                <meta:taskHandler type="form"/>

                <meta:form
                    title="Licence Delivery Confirmation">

                    <meta:field
                        id="received"
                        variable="received"
                        type="boolean"
                        required="true"
                        label="Have you received your updated driving licence?"/>

                </meta:form>

            </bpmn:extensionElements>

        </bpmn:userTask>

        <!-- ================================================== -->
        <!-- Receipt Gateway                                    -->
        <!-- ================================================== -->

        <bpmn:exclusiveGateway
            id="receipt_gateway"
            default="f_not_received">

            <bpmn:incoming>f5</bpmn:incoming>

            <bpmn:outgoing>f_received</bpmn:outgoing>
            <bpmn:outgoing>f_not_received</bpmn:outgoing>

        </bpmn:exclusiveGateway>

        <!-- ================================================== -->
        <!-- Success                                            -->
        <!-- ================================================== -->

        <bpmn:endEvent
            id="success"
            name="Journey Complete">

            <bpmn:incoming>f_received</bpmn:incoming>

        </bpmn:endEvent>

        <!-- ================================================== -->
        <!-- Delivery Failure                                   -->
        <!-- ================================================== -->

        <bpmn:endEvent
            id="delivery_failure">

            <bpmn:incoming>f_not_received</bpmn:incoming>

            <bpmn:errorEventDefinition
                errorRef="DeliveryFailure"/>

        </bpmn:endEvent>

        <!-- ================================================== -->
        <!-- Sequence Flows                                     -->
        <!-- ================================================== -->

        <bpmn:sequenceFlow
            id="f1"
            sourceRef="start"
            targetRef="send_confirmation"/>

        <bpmn:sequenceFlow
            id="f2"
            sourceRef="send_confirmation"
            targetRef="submission_complete"/>

        <bpmn:sequenceFlow
            id="f3"
            sourceRef="submission_complete"
            targetRef="wait_for_delivery"/>

        <bpmn:sequenceFlow
            id="f4"
            sourceRef="wait_for_delivery"
            targetRef="confirm_receipt"/>

        <bpmn:sequenceFlow
            id="f5"
            sourceRef="confirm_receipt"
            targetRef="receipt_gateway"/>

        <bpmn:sequenceFlow
            id="f_received"
            sourceRef="receipt_gateway"
            targetRef="success">

            <bpmn:conditionExpression
                xsi:type="bpmn:tFormalExpression">

                received == true

            </bpmn:conditionExpression>

        </bpmn:sequenceFlow>

        <bpmn:sequenceFlow
            id="f_not_received"
            sourceRef="receipt_gateway"
            targetRef="delivery_failure"/>

    </bpmn:process>

</bpmn:definitions>