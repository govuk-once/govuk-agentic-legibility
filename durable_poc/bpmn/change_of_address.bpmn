<?xml version="1.0" encoding="UTF-8"?>

<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:meta="urn:durable-workflow:metadata:v1"
    targetNamespace="urn:durable-workflow:processes:v1"
    id="dvla_change_address">

    <!-- ====================================================== -->
    <!-- Errors                                                   -->
    <!-- ====================================================== -->

    <bpmn:error id="ApiFailure" name="ApiFailure"/>
    <bpmn:error id="InvalidPhoto" name="InvalidPhoto"/>
    <bpmn:error id="InvalidSignature" name="InvalidSignature"/>
    <bpmn:error id="InvalidAddress" name="InvalidAddress"/>
    <bpmn:error id="DeliveryFailure" name="DeliveryFailure"/>
    <bpmn:error id="UserCancelled" name="UserCancelled"/>
    <bpmn:error id="PostalApplicationRequired" name="PostalApplicationRequired"/>

    <!-- ====================================================== -->
    <!-- Main Process                                             -->
    <!-- ====================================================== -->

    <bpmn:process
        id="change_address"
        name="Driving Licence Change Of Address"
        isExecutable="true">

        <bpmn:extensionElements>

            <meta:workflowMetadata
                name="Driving Licence Change Of Address"
                version="1.0.0"/>

        </bpmn:extensionElements>

        <!-- ================================================== -->
        <!-- Events                                              -->
        <!-- ================================================== -->

        <bpmn:startEvent
            id="start"
            name="Start">
            <bpmn:outgoing>f1</bpmn:outgoing>
        </bpmn:startEvent>

        <!-- ================================================== -->
        <!-- Confirm Intent                                      -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_confirm_intent"
            name="Confirm Intent"
            calledElement="confirm_intent">

            <bpmn:extensionElements>

                <meta:validateOutputs enabled="true"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f1</bpmn:incoming>
            <bpmn:outgoing>f2</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="confirm_cancelled"
            attachedToRef="run_confirm_intent"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="UserCancelled"/>

            <bpmn:outgoing>f_cancel</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Name Check                                   -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_name_change_check"
            name="Name Change Check"
            calledElement="name_change_check">

            <bpmn:extensionElements>

                <meta:validateOutputs enabled="true"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f2</bpmn:incoming>
            <bpmn:outgoing>f3</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="postal_required"
            attachedToRef="run_name_change_check"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="PostalApplicationRequired"/>

            <bpmn:outgoing>
                f_postal_required
            </bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Driver Lookup                                       -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_driver_lookup"
            name="Verify Driver"
            calledElement="driver_lookup">

            <bpmn:extensionElements>

                <meta:validateInputs enabled="true"/>
                <meta:validateOutputs enabled="true"/>

                <meta:output
                    source="driver_id"
                    target="driver_id"/>

                <meta:output
                    source="email"
                    target="email"/>

                <meta:output
                    source="current_address"
                    target="current_address"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f3</bpmn:incoming>
            <bpmn:outgoing>f4</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="driver_lookup_error"
            attachedToRef="run_driver_lookup"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>f_exception_1</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Photo Journey                                       -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_photo_update"
            name="Photo Journey"
            calledElement="photo_update">

            <bpmn:extensionElements>

                <meta:validateInputs enabled="true"/>
                <meta:validateOutputs enabled="true"/>

                <meta:input
                    source="driver_id"
                    target="driver_id"/>

                <meta:output
                    source="photo_id"
                    target="photo_id"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f4</bpmn:incoming>
            <bpmn:outgoing>f5</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="photo_invalid"
            attachedToRef="run_photo_update"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="InvalidPhoto"/>

            <bpmn:outgoing>f_rejected_2</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <bpmn:boundaryEvent
            id="photo_api_error"
            attachedToRef="run_photo_update"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>f_exception_2</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Signature Journey                                       -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_signature_update"
            name="Signature Update"
            calledElement="signature_update">

            <bpmn:extensionElements>

                <meta:validateInputs enabled="true"/>
                <meta:validateOutputs enabled="true"/>

                <meta:input
                    source="driver_id"
                    target="driver_id"/>

                <meta:output
                    source="signature_id"
                    target="signature_id"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f5</bpmn:incoming>
            <bpmn:outgoing>f6</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="signature_invalid"
            attachedToRef="run_signature_update"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="InvalidSignature"/>

            <bpmn:outgoing>
                f_rejected_1
            </bpmn:outgoing>

        </bpmn:boundaryEvent>

        <bpmn:boundaryEvent
            id="signature_api_error"
            attachedToRef="run_signature_update"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>
                f_exception_3
            </bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Organ Journey                                       -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_organ_donation"
            name="Organ Donation"
            calledElement="organ_donation">

            <bpmn:extensionElements>

                <meta:validateInputs enabled="true"/>
                <meta:validateOutputs enabled="true"/>

                <meta:input
                    source="driver_id"
                    target="driver_id"/>

                <meta:output
                    source="organ_consent"
                    target="organ_consent"/>

            </bpmn:extensionElements>
            
            <bpmn:incoming>f6</bpmn:incoming>
            <bpmn:outgoing>f7</bpmn:outgoing>

        </bpmn:callActivity>

        <!-- ================================================== -->
        <!-- Address Selection                                   -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_address_selection"
            name="Select Address"
            calledElement="address_selection">

            <bpmn:extensionElements>

                <meta:validateInputs enabled="true"/>
                <meta:validateOutputs enabled="true"/>

                <meta:output
                    source="address"
                    target="address"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f7</bpmn:incoming>
            <bpmn:outgoing>f8</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="address_selection_error"
            attachedToRef="run_address_selection"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>f_exception_4</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Address Update                                      -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_address_update"
            name="Submit Address Change"
            calledElement="address_update">

            <bpmn:extensionElements>

                <meta:validateInputs enabled="true"/>
                <meta:validateOutputs enabled="true"/>

                <meta:input
                    source="driver_id"
                    target="driver_id"/>

                <meta:input
                    source="address"
                    target="address"/>

                <meta:input
                    source="photo_id"
                    target="photo_id"/>

                <meta:input
                    source="signature_id"
                    target="signature_id"/>

                <meta:output
                    source="job_id"
                    target="job_id"/>

                <meta:output
                    source="status"
                    target="status"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f8</bpmn:incoming>
            <bpmn:outgoing>f9</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="address_invalid"
            attachedToRef="run_address_update"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="InvalidAddress"/>

            <bpmn:outgoing>f_rejected_3</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <bpmn:boundaryEvent
            id="address_update_error"
            attachedToRef="run_address_update"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="ApiFailure"/>

            <bpmn:outgoing>f_exception_5</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- Finalisation                                        -->
        <!-- ================================================== -->

        <bpmn:callActivity
            id="run_finalisation"
            name="Finalisation"
            calledElement="finalisation">

            <bpmn:extensionElements>

                <meta:validateInputs enabled="true"/>
                <meta:validateOutputs enabled="true"/>

                <meta:input
                    source="driver_id"
                    target="driver_id"/>

                <meta:input
                    source="email"
                    target="email"/>

                <meta:input
                    source="address"
                    target="address"/>

                <meta:input
                    source="job_id"
                    target="job_id"/>

                <meta:input
                    source="organ_consent"
                    target="organ_consent"/>

                <meta:output
                    source="confirmation_sent"
                    target="confirmation_sent"/>

            </bpmn:extensionElements>

            <bpmn:incoming>f9</bpmn:incoming>
            <bpmn:outgoing>f10</bpmn:outgoing>

        </bpmn:callActivity>

        <bpmn:boundaryEvent
            id="finalisation_error"
            attachedToRef="run_finalisation"
            cancelActivity="true">

            <bpmn:errorEventDefinition
                errorRef="DeliveryFailure"/>

            <bpmn:outgoing>f_exception_6</bpmn:outgoing>

        </bpmn:boundaryEvent>

        <!-- ================================================== -->
        <!-- End Events                                          -->
        <!-- ================================================== -->

        <bpmn:endEvent
            id="end_success"
            name="Address Updated">
            <bpmn:incoming>f10</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:endEvent
            id="end_cancelled"
            name="Journey Cancelled">
            <bpmn:incoming>f_cancel</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:endEvent
            id="end_rejected"
            name="Request Rejected">
            <bpmn:incoming>f_rejected_1</bpmn:incoming>
            <bpmn:incoming>f_rejected_2</bpmn:incoming>
            <bpmn:incoming>f_rejected_3</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:endEvent
            id="end_postal_required"
            name="Postal Application Required">

            <bpmn:incoming>
                f_postal_required
            </bpmn:incoming>

        </bpmn:endEvent>

        <bpmn:endEvent
            id="end_exception"
            name="Journey Failed">

            <bpmn:incoming>f_exception_1</bpmn:incoming>
            <bpmn:incoming>f_exception_2</bpmn:incoming>
            <bpmn:incoming>f_exception_3</bpmn:incoming>
            <bpmn:incoming>f_exception_4</bpmn:incoming>
            <bpmn:incoming>f_exception_5</bpmn:incoming>
            <bpmn:incoming>f_exception_6</bpmn:incoming>

        </bpmn:endEvent>

        <!-- ================================================== -->
        <!-- Sequence Flows                                      -->
        <!-- ================================================== -->

        <bpmn:sequenceFlow
            id="f1"
            sourceRef="start"
            targetRef="run_confirm_intent"/>

        <bpmn:sequenceFlow
            id="f2"
            sourceRef="run_confirm_intent"
            targetRef="run_name_change_check"/>

        <bpmn:sequenceFlow
            id="f3"
            sourceRef="run_name_change_check"
            targetRef="run_driver_lookup"/>

        <bpmn:sequenceFlow
            id="f4"
            sourceRef="run_driver_lookup"
            targetRef="run_photo_update"/>

        <bpmn:sequenceFlow
            id="f5"
            sourceRef="run_photo_update"
            targetRef="run_signature_update"/>

        <bpmn:sequenceFlow
            id="f6"
            sourceRef="run_signature_update"
            targetRef="run_organ_donation"/>
        
        <bpmn:sequenceFlow
            id="f7"
            sourceRef="run_organ_donation"
            targetRef="run_address_selection"/>

        <bpmn:sequenceFlow
            id="f8"
            sourceRef="run_address_selection"
            targetRef="run_address_update"/>

        <bpmn:sequenceFlow
            id="f9"
            sourceRef="run_address_update"
            targetRef="run_finalisation"/>

        <bpmn:sequenceFlow
            id="f10"
            sourceRef="run_finalisation"
            targetRef="end_success"/>

        <bpmn:sequenceFlow
            id="f_rejected_1"
            sourceRef="signature_invalid"
            targetRef="end_rejected"/>

        <bpmn:sequenceFlow
            id="f_rejected_2"
            sourceRef="photo_invalid"
            targetRef="end_rejected"/>

        <bpmn:sequenceFlow
            id="f_rejected_3"
            sourceRef="address_invalid"
            targetRef="end_rejected"/>

        <bpmn:sequenceFlow
            id="f_exception_1"
            sourceRef="driver_lookup_error"
            targetRef="end_exception"/>

        <bpmn:sequenceFlow
            id="f_exception_2"
            sourceRef="photo_api_error"
            targetRef="end_exception"/>
        
        <bpmn:sequenceFlow
            id="f_exception_3"
            sourceRef="signature_api_error"
            targetRef="end_exception"/>

        <bpmn:sequenceFlow
            id="f_exception_4"
            sourceRef="address_selection_error"
            targetRef="end_exception"/>

        <bpmn:sequenceFlow
            id="f_exception_5"
            sourceRef="address_update_error"
            targetRef="end_exception"/>

        <bpmn:sequenceFlow
            id="f_exception_6"
            sourceRef="finalisation_error"
            targetRef="end_exception"/>

        <bpmn:sequenceFlow
            id="f_cancel"
            sourceRef="confirm_cancelled"
            targetRef="end_cancelled"/>

        <bpmn:sequenceFlow
            id="f_postal_required"
            sourceRef="postal_required"
            targetRef="end_postal_required"/>
        
    </bpmn:process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_change_address"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">

  <bpmndi:BPMNPlane
      id="BPMNPlane_change_address"
      bpmnElement="change_address">

    <!-- Events -->

    <bpmndi:BPMNShape bpmnElement="start" id="start_di">
      <dc:Bounds x="100" y="220" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="end_success" id="end_success_di">
      <dc:Bounds x="2470" y="220" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="end_cancelled" id="end_cancelled_di">
      <dc:Bounds x="320" y="60" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="end_postal_required" id="end_postal_required_di">
      <dc:Bounds x="620" y="60" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="end_rejected" id="end_rejected_di">
      <dc:Bounds x="1600" y="420" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="end_exception" id="end_exception_di">
      <dc:Bounds x="1800" y="560" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <!-- Call Activities -->

    <bpmndi:BPMNShape bpmnElement="run_confirm_intent" id="run_confirm_intent_di">
      <dc:Bounds x="180" y="180" width="120" height="80"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="run_name_change_check" id="run_name_change_check_di">
      <dc:Bounds x="420" y="180" width="120" height="80"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="run_driver_lookup" id="run_driver_lookup_di">
      <dc:Bounds x="660" y="180" width="120" height="80"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="run_photo_update" id="run_photo_update_di">
      <dc:Bounds x="900" y="180" width="120" height="80"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="run_signature_update" id="run_signature_update_di">
      <dc:Bounds x="1140" y="180" width="120" height="80"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="run_organ_donation" id="run_organ_donation_di">
      <dc:Bounds x="1380" y="180" width="120" height="80"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="run_address_selection" id="run_address_selection_di">
      <dc:Bounds x="1620" y="180" width="120" height="80"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="run_address_update" id="run_address_update_di">
      <dc:Bounds x="1860" y="180" width="120" height="80"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="run_finalisation" id="run_finalisation_di">
      <dc:Bounds x="2100" y="180" width="120" height="80"/>
    </bpmndi:BPMNShape>

    <!-- Boundary Events -->

    <bpmndi:BPMNShape bpmnElement="confirm_cancelled" id="confirm_cancelled_di">
      <dc:Bounds x="272" y="242" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="postal_required" id="postal_required_di">
      <dc:Bounds x="512" y="242" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="driver_lookup_error" id="driver_lookup_error_di">
      <dc:Bounds x="752" y="242" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="photo_invalid" id="photo_invalid_di">
      <dc:Bounds x="960" y="242" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="photo_api_error" id="photo_api_error_di">
      <dc:Bounds x="996" y="242" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="signature_invalid" id="signature_invalid_di">
      <dc:Bounds x="1200" y="242" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="signature_api_error" id="signature_api_error_di">
      <dc:Bounds x="1236" y="242" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="address_selection_error" id="address_selection_error_di">
      <dc:Bounds x="1712" y="242" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="address_invalid" id="address_invalid_di">
      <dc:Bounds x="1920" y="242" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="address_update_error" id="address_update_error_di">
      <dc:Bounds x="1956" y="242" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <bpmndi:BPMNShape bpmnElement="finalisation_error" id="finalisation_error_di">
      <dc:Bounds x="2192" y="242" width="36" height="36"/>
    </bpmndi:BPMNShape>

    <!-- Happy Path Flows -->

    <bpmndi:BPMNEdge bpmnElement="f1">
      <di:waypoint x="136" y="238"/>
      <di:waypoint x="180" y="220"/>
    </bpmndi:BPMNEdge>

    <bpmndi:BPMNEdge bpmnElement="f2">
      <di:waypoint x="300" y="220"/>
      <di:waypoint x="420" y="220"/>
    </bpmndi:BPMNEdge>

    <bpmndi:BPMNEdge bpmnElement="f3">
      <di:waypoint x="540" y="220"/>
      <di:waypoint x="660" y="220"/>
    </bpmndi:BPMNEdge>

    <bpmndi:BPMNEdge bpmnElement="f4">
      <di:waypoint x="780" y="220"/>
      <di:waypoint x="900" y="220"/>
    </bpmndi:BPMNEdge>

    <bpmndi:BPMNEdge bpmnElement="f5">
      <di:waypoint x="1020" y="220"/>
      <di:waypoint x="1140" y="220"/>
    </bpmndi:BPMNEdge>

    <bpmndi:BPMNEdge bpmnElement="f6">
      <di:waypoint x="1260" y="220"/>
      <di:waypoint x="1380" y="220"/>
    </bpmndi:BPMNEdge>

    <bpmndi:BPMNEdge bpmnElement="f7">
      <di:waypoint x="1500" y="220"/>
      <di:waypoint x="1620" y="220"/>
    </bpmndi:BPMNEdge>

    <bpmndi:BPMNEdge bpmnElement="f8">
      <di:waypoint x="1740" y="220"/>
      <di:waypoint x="1860" y="220"/>
    </bpmndi:BPMNEdge>

    <bpmndi:BPMNEdge bpmnElement="f9">
      <di:waypoint x="1980" y="220"/>
      <di:waypoint x="2100" y="220"/>
    </bpmndi:BPMNEdge>

    <bpmndi:BPMNEdge bpmnElement="f10">
      <di:waypoint x="2220" y="220"/>
      <di:waypoint x="2470" y="238"/>
    </bpmndi:BPMNEdge>

    <!-- Cancel -->

    <bpmndi:BPMNEdge bpmnElement="f_cancel">
      <di:waypoint x="290" y="242"/>
      <di:waypoint x="290" y="78"/>
      <di:waypoint x="320" y="78"/>
    </bpmndi:BPMNEdge>

    <!-- Postal -->

    <bpmndi:BPMNEdge bpmnElement="f_postal_required">
      <di:waypoint x="530" y="242"/>
      <di:waypoint x="530" y="78"/>
      <di:waypoint x="620" y="78"/>
    </bpmndi:BPMNEdge>

    <!-- Rejections -->

    <bpmndi:BPMNEdge bpmnElement="f_rejected_1">
      <di:waypoint x="1218" y="260"/>
      <di:waypoint x="1218" y="438"/>
      <di:waypoint x="1600" y="438"/>
    </bpmndi:BPMNEdge>

    <bpmndi:BPMNEdge bpmnElement="f_rejected_2">
      <di:waypoint x="978" y="260"/>
      <di:waypoint x="978" y="438"/>
      <di:waypoint x="1600" y="438"/>
    </bpmndi:BPMNEdge>

    <bpmndi:BPMNEdge bpmnElement="f_rejected_3">
      <di:waypoint x="1938" y="260"/>
      <di:waypoint x="1938" y="438"/>
      <di:waypoint x="1600" y="438"/>
    </bpmndi:BPMNEdge>

    <!-- Exceptions -->

    <bpmndi:BPMNEdge bpmnElement="f_exception_1">
