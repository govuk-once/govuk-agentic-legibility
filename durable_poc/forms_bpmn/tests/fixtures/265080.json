    "available_languages": [
      "en"
    ],
    "declaration_markdown": "By submitting this form you’re confirming that:\n\n1. you will not be able to view any pre‑publication patents that were submitted before your account was linked\n   \n2. the name and address you provide must exactly match the legal entity details on your IP account\n   \n3. to the best of your knowledge, the information you have provided is correct",
    "what_happens_next_markdown": "Your request will be reviewed by our dedicated support team who will carry out validation checks.\r\n\r\nIf your request identifies missing IP rights from your IP account, we will post a letter, to the address for service against the application or publication number(s) you provided. \r\n\r\nIf your request is not accepted, we will notify you by email. You may be asked to submit a new request to add IP rights form.\r\n\r\nWhat you can do now\r\n\r\n[Go to account home (opens in new tab)](https://www.manage-intellectual-property.service.gov.uk/)",
    "send_daily_submission_batch": false,
    "send_weekly_submission_batch": false
