    <bpmn:task id="state_9WSHmVcK_5f__5f_exit_5f_1" name="Show exit: You cannot complete this application">
      <bpmn:extensionElements>
        <forms:stateRef stateId="9WSHmVcK__exit_1" />
        <forms:state>{"type": "output", "channel": "transcript", "message": "You cannot complete this application\n\nYou can only apply for an armed forces veterans badge for a serviceperson who's died if you get either:  \r\n\r\n* a [War Widow’s or Widower’s Pension](https://www.gov.uk/war-widow-pension)\r\n* compensation under the [Survivors Guaranteed Income Payment (SGIP)](https://www.gov.uk/guidance/support-after-the-death-of-a-service-person-or-veteran) \r\n\r\n[Back to GOV.UK](https://www.gov.uk/apply-medal-or-veterans-badge)", "next": "9WSHmVcK__exit_1__end"}</forms:state>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_9WSHmVcK_5f__5f_route_5f__5f_rule_5f_1</bpmn:incoming>
