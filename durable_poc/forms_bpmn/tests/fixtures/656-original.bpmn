    <bpmn:task id="state_KBregWzz_5f__5f_exit_5f_1" name="Show exit: You cannot apply for a veterans badge yet">
      <bpmn:extensionElements>
        <forms:stateRef stateId="KBregWzz__exit_1" />
        <forms:state>{"type": "output", "channel": "transcript", "message": "You cannot apply for a veterans badge yet\n\nVeterans badges are sent out automatically when someone leaves the armed forces.  \r\n\r\nIf you’re about to leave or have left in the last 6 months, you do not need to apply - your badge will be sent automatically.  \r\n\r\n## If it’s been more than 6 months since you left the armed forces  \r\nCall the Joint Personnel Administraton Centre (JPAC) if it’s been more than 6 months and you’ve still not got your badge: \r\n \r\nPhone: 0800 085 3600 \r\n\r\nPhone: 0044 141 224 3600 (overseas) \r\n\r\nPhone: 94560 3600 (military)\r\n\r\n[Back to GOV.UK](https://(https://www.gov.uk/apply-medal-or-veterans-badge))", "next": "KBregWzz__exit_1__end"}</forms:state>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_KBregWzz_5f__5f_route_5f__5f_rule_5f_1</bpmn:incoming>
      <bpmn:outgoing>flow_KBregWzz_5f__5f_exit_5f_1_5f__5f_next</bpmn:outgoing>
    </bpmn:task>
