{
  "type": "object",
  "properties": {
    "what_type_of_permit_do_you_need": {
      "type": "string",
      "enum": ["Resident permit", "Business permit"]
    },
    "business_name": {
      "type": "string"
    },
    "your_name": {
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "title": { "type": "string" }
      },
      "required": ["firstName", "lastName"],
      "additionalProperties": false
    },
    "your_home_address": {
      "type": "object",
      "properties": {
        "line1": { "type": "string" },
        "line2": { "type": "string" },
        "town": { "type": "string" },
        "postcode": { "type": "string" }
      },
      "required": ["line1", "town", "postcode"],
      "additionalProperties": false
    },
    "vehicle_registration_number": {
      "type": "string",
      "maxLength": 500
    },
    "date_you_want_the_permit_to_start": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "what_type_of_permit_do_you_need",
    "your_name",
    "your_home_address",
    "vehicle_registration_number",
    "date_you_want_the_permit_to_start"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "what_type_of_permit_do_you_need": { "const": "Resident permit" }
            },
            "required": ["what_type_of_permit_do_you_need"]
          }
        ]
      },
      "then": {
        "not": { "required": ["business_name"] }
      },
      "else": {
        "required": ["business_name"]
      }
    }
  ]
}
