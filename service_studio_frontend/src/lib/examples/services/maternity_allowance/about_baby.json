{
    "process_id": "about_baby",
    "version": "0.1.0",
    "start": "prompt_is_baby_born",
    "vars": {
        "is_baby_born": null,
        "is_stillborn_or_died": null,
        "actual_birth_date": null,
        "due_date": null,
        "calculated_dates": null,
        "born_in_uk": null,
        "birth_evidence_method": null,
        "birth_certificate_system_number": null,
        "matb1_upload_ref": null,
        "matb1_upload_attempts": 0,
        "birth_certificate_upload_ref": null,
        "birth_cert_upload_attempts": 0
    },
    "states": {
        "prompt_is_baby_born": {
            "type": "input",
            "prompt": "Has your baby already been born?",
            "schema": {
                "kind": "boolean"
            },
            "assign": "is_baby_born",
            "next": "branch_baby_status"
        },
        "branch_baby_status": {
            "type": "choice",
            "rules": [
                {
                    "when": {
                        "op": "is_true",
                        "path": "is_baby_born"
                    },
                    "next": "check_bereavement_status"
                }
            ],
            "default": "prompt_due_date_unborn"
        },
        "check_bereavement_status": {
            "type": "input",
            "prompt": "Was your baby stillborn or did your baby die?",
            "schema": {
                "kind": "boolean"
            },
            "assign": "is_stillborn_or_died",
            "next": "branch_bereavement_status"
        },
        "branch_bereavement_status": {
            "type": "choice",
            "rules": [
                {
                    "when": {
                        "op": "is_true",
                        "path": "is_stillborn_or_died"
                    },
                    "next": "say_bereavement_guidance"
                }
            ],
            "default": "prompt_born_in_uk"
        },
        "say_bereavement_guidance": {
            "type": "output",
            "channel": "transcript",
            "message": "We are very sorry for your loss. Special rules apply to claims in cases of stillbirth or infant death. Please read Page 4 of the MA1 Notes or contact us on 0800 169 0283 so we can assist you with completing the paper MA1 form and submitting your certificate of stillbirth.",
            "next": "end_bereavement"
        },
        "end_bereavement": {
            "type": "end",
            "status": "failed",
            "outcome": "bereavement_offramp"
        },
        "prompt_born_in_uk": {
            "type": "input",
            "prompt": "Was your baby born in the UK?",
            "schema": {
                "kind": "boolean"
            },
            "assign": "born_in_uk",
            "next": "branch_born_in_uk"
        },
        "branch_born_in_uk": {
            "type": "choice",
            "rules": [
                {
                    "when": {
                        "op": "is_true",
                        "path": "born_in_uk"
                    },
                    "next": "prompt_actual_birth_date"
                }
            ],
            "default": "say_offramp_born_outside_uk"
        },
        "say_offramp_born_outside_uk": {
            "type": "output",
            "channel": "transcript",
            "message": "Because your baby was born outside the UK, you cannot complete your claim using this online service. Please complete your claim using the paper MA1 form and post it along with your baby's foreign birth certificate and official translation.",
            "next": "end_offramp_paper"
        },
        "prompt_actual_birth_date": {
            "type": "input",
            "prompt": "Enter your baby's actual date of birth (DD/MM/YYYY):",
            "schema": {
                "kind": "string",
                "pattern": "^(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[012])/(19|20)\\d{2}$",
                "invalid_message": "Please enter a valid date in DD/MM/YYYY format."
            },
            "assign": "actual_birth_date",
            "next": "evaluate_actual_birth_date"
        },
        "evaluate_actual_birth_date": {
            "type": "choice",
            "rules": [
                {
                    "when": {
                        "op": "date_before",
                        "path": "__now__",
                        "value_path": "actual_birth_date"
                    },
                    "next": "say_future_birth_date_error"
                }
            ],
            "default": "prompt_due_date_born"
        },
        "say_future_birth_date_error": {
            "type": "output",
            "channel": "transcript",
            "message": "Invalid Birth Date: Your baby's actual date of birth cannot be in the future. If your baby has not been born yet, please go back and select 'No'.",
            "next": "prompt_actual_birth_date"
        },
        "prompt_due_date_born": {
            "type": "input",
            "prompt": "Enter the date your baby was originally due from your MAT B1 maternity certificate (DD/MM/YYYY):",
            "schema": {
                "kind": "string",
                "pattern": "^(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[012])/(19|20)\\d{2}$",
                "invalid_message": "Please enter a valid date in DD/MM/YYYY format."
            },
            "assign": "due_date",
            "next": "run_born_timeline_calculations"
        },
        "prompt_due_date_unborn": {
            "type": "input",
            "prompt": "Enter your expected childbirth date from your MAT B1 maternity certificate (DD/MM/YYYY):",
            "schema": {
                "kind": "string",
                "pattern": "^(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[012])/(19|20)\\d{2}$",
                "invalid_message": "Please enter a valid date in DD/MM/YYYY format."
            },
            "assign": "due_date",
            "next": "run_unborn_timeline_calculations"
        },
        "run_born_timeline_calculations": {
            "type": "invoke",
            "process": "calculate_deadlines",
            "input": {
                "due_date": {
                    "$": "due_date"
                },
                "actual_birth_date": {
                    "$": "actual_birth_date"
                },
                "is_baby_born": true
            },
            "assign": "calculated_dates",
            "next": "evaluate_backdating_limit"
        },
        "run_unborn_timeline_calculations": {
            "type": "invoke",
            "process": "calculate_deadlines",
            "input": {
                "due_date": {
                    "$": "due_date"
                },
                "actual_birth_date": null,
                "is_baby_born": false
            },
            "assign": "calculated_dates",
            "next": "evaluate_pre_birth_window"
        },
        "evaluate_backdating_limit": {
            "type": "choice",
            "rules": [
                {
                    "when": {
                        "op": "is_true",
                        "path": "calculated_dates.is_claim_backdated_over_3_months"
                    },
                    "next": "say_backdating_warning"
                }
            ],
            "default": "prompt_matb1_file"
        },
        "say_backdating_warning": {
            "type": "output",
            "channel": "transcript",
            "message": "Notice: Maternity Allowance can only be backdated for up to 3 months. Because your claim is submitted more than 3 months after your baby's birth, your payment start date is set automatically to the day after birth, but you risk losing payments for any period prior to the 3-month backdating limit.",
            "next": "prompt_matb1_file"
        },
        "evaluate_pre_birth_window": {
            "type": "choice",
            "rules": [
                {
                    "when": {
                        "op": "is_true",
                        "path": "calculated_dates.is_too_early"
                    },
                    "next": "say_too_early_to_claim"
                }
            ],
            "default": "prompt_matb1_file"
        },
        "say_too_early_to_claim": {
            "type": "output",
            "channel": "transcript",
            "message": "You have applied too early. Claims cannot be submitted earlier than 14 weeks before your due week. Based on your expected due date, your claim window opens on {{calculated_dates.earliest_signing_date}}.",
            "next": "end_too_early_to_claim"
        },
        "end_too_early_to_claim": {
            "type": "end",
            "status": "failed",
            "outcome": "too_early_to_claim"
        },
        "prompt_matb1_file": {
            "type": "input",
            "prompt": "Upload a photo or scan of your MAT B1 maternity certificate (JPEG, PNG, or PDF).",
            "schema": {
                "kind": "file_ref",
                "accept": [
                    "image/jpeg",
                    "image/png",
                    "application/pdf"
                ],
                "allow_skip": false
            },
            "assign": "matb1_file",
            "next": "upload_matb1_api"
        },
        "upload_matb1_api": {
            "type": "call",
            "method": "POST",
            "service": "dwp",
            "url": "/app/dwp/v1/upload",
            "body": {
                "document_type": "MATB1",
                "filename": {
                    "$": "matb1_file.ref"
                },
                "content_type": {
                    "$": "matb1_file.content_type"
                },
                "file_bytes_approx": {
                    "$": "matb1_file.bytes"
                }
            },
            "idempotency_key": "{{workflow_id}}:upload_matb1_{{step}}",
            "assign": "upload_res",
            "capture": {
                "matb1_upload_ref": "body.upload_ref",
                "matb1_upload_status": "body.status"
            },
            "catch": [
                {
                    "on": "any",
                    "next": "prompt_matb1_file"
                }
            ],
            "next": "check_matb1_upload"
        },
        "check_matb1_upload": {
            "type": "choice",
            "rules": [
                {
                    "when": {
                        "op": "not_empty",
                        "path": "upload_res.matb1_upload_ref"
                    },
                    "next": "check_birth_certificate_required"
                }
            ],
            "default": "increment_matb1_attempts"
        },
        "increment_matb1_attempts": {
            "type": "assign",
            "set": {
                "matb1_upload_attempts": {
                    "op": "add",
                    "path": "matb1_upload_attempts",
                    "value": 1
                }
            },
            "next": "evaluate_matb1_attempts"
        },
        "evaluate_matb1_attempts": {
            "type": "choice",
            "rules": [
                {
                    "when": {
                        "op": "gte",
                        "path": "matb1_upload_attempts",
                        "value": 3
                    },
                    "next": "end_offramp_paper"
                }
            ],
            "default": "prompt_retry_matb1"
        },
        "prompt_retry_matb1": {
            "type": "output",
            "channel": "transcript",
            "message": "Upload failed or missing. Please try uploading your MAT B1 certificate again (Attempt {{matb1_upload_attempts}} of 3).",
            "next": "prompt_matb1_file"
        },
        "check_birth_certificate_required": {
            "type": "choice",
            "rules": [
                {
                    "when": {
                        "op": "is_true",
                        "path": "is_baby_born"
                    },
                    "next": "prompt_birth_evidence_method"
                }
            ],
            "default": "end_section2"
        },
        "prompt_birth_evidence_method": {
            "type": "input",
            "prompt": "How would you like to provide proof of your baby's birth?",
            "schema": {
                "kind": "select_one",
                "options": [
                    {
                        "value": "system_number",
                        "label": "Enter the 9-digit Birth Certificate System Number"
                    },
                    {
                        "value": "upload_certificate",
                        "label": "Upload a digital copy of the Birth Certificate"
                    }
                ]
            },
            "assign": "birth_evidence_method",
            "next": "branch_birth_evidence_method"
        },
        "branch_birth_evidence_method": {
            "type": "choice",
            "rules": [
                {
                    "when": {
                        "op": "eq",
                        "path": "birth_evidence_method",
                        "value": "system_number"
                    },
                    "next": "prompt_uk_birth_system_number"
                }
            ],
            "default": "upload_birth_certificate"
        },
        "prompt_uk_birth_system_number": {
            "type": "input",
            "prompt": "Enter the 9-digit System Number from the bottom-left corner of your UK birth certificate:",
            "schema": {
                "kind": "string",
                "pattern": "^[0-9]{9}$",
                "invalid_message": "UK Birth certificate system number must be 9 digits."
            },
            "assign": "birth_certificate_system_number",
            "next": "end_section2"
        },
        "upload_birth_certificate": {
            "type": "input",
            "prompt": "Upload a scan or photo of your baby's birth certificate (JPEG, PNG, or PDF).",
            "schema": {
                "kind": "file_ref",
                "accept": [
                    "image/jpeg",
                    "image/png",
                    "application/pdf"
                ],
                "allow_skip": false
            },
            "assign": "birth_cert_file",
            "next": "upload_birth_certificate_api"
        },
        "upload_birth_certificate_api": {
            "type": "call",
            "method": "POST",
            "service": "dwp",
            "url": "/app/dwp/v1/upload",
            "body": {
                "document_type": "BIRTH_CERT",
                "filename": {
                    "$": "birth_cert_file.ref"
                },
                "content_type": {
                    "$": "birth_cert_file.content_type"
                },
                "file_bytes_approx": {
                    "$": "birth_cert_file.bytes"
                }
            },
            "idempotency_key": "{{workflow_id}}:upload_birth_cert_{{step}}",
            "assign": "upload_res",
            "capture": {
                "birth_certificate_upload_ref": "body.upload_ref",
                "birth_cert_upload_status": "body.status"
            },
            "catch": [
                {
                    "on": "any",
                    "next": "increment_birth_cert_attempts"
                }
            ],
            "next": "check_birth_cert_upload"
        },
        "check_birth_cert_upload": {
            "type": "choice",
            "rules": [
                {
                    "when": {
                        "op": "not_empty",
                        "path": "upload_res.birth_certificate_upload_ref"
                    },
                    "next": "end_section2"
                }
            ],
            "default": "increment_birth_cert_attempts"
        },
        "increment_birth_cert_attempts": {
            "type": "assign",
            "set": {
                "birth_cert_upload_attempts": {
                    "op": "add",
                    "path": "birth_cert_upload_attempts",
                    "value": 1
                }
            },
            "next": "evaluate_birth_cert_attempts"
        },
        "evaluate_birth_cert_attempts": {
            "type": "choice",
            "rules": [
                {
                    "when": {
                        "op": "gte",
                        "path": "birth_cert_upload_attempts",
                        "value": 3
                    },
                    "next": "end_offramp_paper"
                }
            ],
            "default": "prompt_retry_birth_cert"
        },
        "prompt_retry_birth_cert": {
            "type": "output",
            "channel": "transcript",
            "message": "Upload failed or missing. Please try uploading your birth certificate again (Attempt {{birth_cert_upload_attempts}} of 3).",
            "next": "upload_birth_certificate"
        },
        "end_offramp_paper": {
            "type": "end",
            "status": "offramp",
            "outcome": "offramp_paper"
        },
        "end_section2": {
            "type": "end",
            "status": "success",
            "return": {
                "is_baby_born": {
                    "$": "is_baby_born"
                },
                "actual_birth_date": {
                    "$": "actual_birth_date"
                },
                "due_date": {
                    "$": "due_date"
                },
                "calculated_dates": {
                    "$": "calculated_dates"
                },
                "born_in_uk": {
                    "$": "born_in_uk"
                },
                "birth_certificate_system_number": {
                    "$": "birth_certificate_system_number"
                },
                "matb1_upload_ref": {
                    "$": "upload_res.matb1_upload_ref"
                },
                "birth_certificate_upload_ref": {
                    "$": "upload_res.birth_certificate_upload_ref"
                }
            }
        }
    }
}