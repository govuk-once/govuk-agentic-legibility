{
    "process_id": "address_update",
    "version": "0.1.0",
    "start": "submit",
    "vars": {
        "submission": null
    },
    "states": {
        "submit": {
            "type": "call",
            "method": "POST",
            "service": "dvla",
            "url": "/app/dvla/v1/licence/address",
            "body": {
                "address": {
                    "$": "input.address"
                },
                "photo_id": {
                    "$": "input.photo_id"
                }
            },
            "idempotency_key": "{{workflow_id}}:address_update",
            "assign": "submission",
            "capture": {
                "status": "status",
                "job_id": "body.job_id"
            },
            "catch": [
                {
                    "on": "api_failure",
                    "next": "end_api_failure"
                },
                {
                    "on": "any",
                    "next": "end_rejected"
                }
            ],
            "next": "branch_accepted"
        },
        "branch_accepted": {
            "type": "choice",
            "rules": [
                {
                    "when": {
                        "op": "eq",
                        "path": "submission.status",
                        "value": 202
                    },
                    "next": "say_update_accepted"
                }
            ],
            "default": "say_update_rejected"
        },
        "say_update_accepted": {
            "type": "output",
            "channel": "transcript",
            "message": "Your driving licence address update has been submitted. Please wait while your application is processed (this background check typically takes up to 24 hours to complete).",
            "next": "end_ok"
        },
        "say_update_rejected": {
            "type": "output",
            "channel": "transcript",
            "message": "Your address update could not be submitted. Please contact DVLA customer support.",
            "next": "end_rejected"
        },
        "end_ok": {
            "type": "end",
            "status": "success",
            "outcome": "updated",
            "return": {
                "$": "submission.job_id"
            }
        },
        "end_rejected": {
            "type": "end",
            "status": "failed",
            "outcome": "rejected"
        },
        "end_api_failure": {
            "type": "end",
            "status": "failed",
            "outcome": "api_failure"
        }
    }
}