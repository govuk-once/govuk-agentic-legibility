    "declaration": {
      "type": "output",
      "name": "Declaration",
      "metadata": {},
      "channel": "transcript",
      "message": "I, the applicant, confirm that the information that is contained in this application is true and correct to the best of my knowledge and belief and that I have made appropriate enquiries to ensure the accuracy of the information that I have submitted. For the avoidance of doubt, I further confirm:\n\n1) That I understand that if, in completing this form, I provide information that I know or suspect to be false then I will be committing a criminal offence for which I may be liable for criminal prosecution. 2) I have permission from all vessel owners to apply for a Thames and Blackwater Herring licence for the vessel named in this application. 3) The vessel named in this application, is registered to the vessel owners under the Merchant Shipping Act 1995. 4) Vessel owners commit to complying with all conditions attached to the licence. 5) All vessel owners understand that if any of the details provided in this application change, any licence issued will be invalid. 6) That I understand that in accordance with the requirements of the Thames Estuary and Blackwater Herring Licence, a landing declaration must be submitted within 48 hours of landing.",
      "on_error": "fail",
      "next": "declaration_accept"
    },
    "declaration_accept": {
      "type": "input",
      "name": "Accept Declaration",
      "metadata": {},
      "prompt": "Do you accept this declaration?",
      "schema": {
        "kind": "boolean",
        "allow_skip": false
      },
      "assign": "declaration.accepted",
      "next": "declaration_route"
    },
    "declaration_route": {
      "type": "choice",
      "name": "Declaration Decision",
      "metadata": {},
      "rules": [
        {
          "when": {
            "op": "is_true",
            "path": "declaration.accepted"
          },
          "next": "step_1"
        }
      ],
      "default": "declaration_declined"
    },
    "declaration_declined": {
      "type": "end",
      "name": "Declaration Declined",
      "metadata": {},
      "status": "offramp",
      "outcome": "declaration_declined"
