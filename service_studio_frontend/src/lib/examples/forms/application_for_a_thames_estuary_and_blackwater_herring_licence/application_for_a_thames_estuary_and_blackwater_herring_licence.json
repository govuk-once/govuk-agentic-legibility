    "step_1": {
      "type": "input",
      "name": "Are you applying for a Thames Estuary & Blackwater Herring licence",
      "metadata": {
        "forms_step_id": "aaRkcrXf",
        "position": 1,
        "page_heading": "Introduction",
        "guidance_markdown": "Thames Estuary and Blackwater Herring is the herring stock in the maritime region of the Thames estuary. \r\n\r\nThis quota may only be used by vessels participating in the fishery to allow fisheries based data collection for this stock as assessed by the Centre for Environment Fisheries and Aquaculture Science (CEFAS).\r\n\r\nThis fishery may only be fished from 1 September to 31 January, or until the total allowable catch (TAC) is caught.\r\n\r\nThis fishery is not covered by catch recording and so a landing declaration must be submitted within 48 hours. Blank landing declarations can be found here [TEBWH_Landing_Declaration_Form_.pdf](https://assets.publishing.service.gov.uk/media/689c64c19a65499b446361a0/TEBWH_Landing_Declaration_Form_.pdf)",
        "answer_type": "selection",
        "hint_text": "",
        "optional": false,
        "repeatable": false,
        "answer_settings": {
          "only_one_option": "true",
          "selection_options": [
            {
              "name": "Yes",
              "value": "Yes",
              "is_other": false,
              "requires_text": false
            },
            {
              "name": "No",
              "value": "No",
              "is_other": false,
              "requires_text": false
            }
          ],
          "none_of_the_above_question": null,
          "input_type": null,
          "title_needed": null
        }
      },
      "prompt": "Are you applying for a Thames Estuary & Blackwater Herring licence?",
      "schema": {
        "kind": "boolean",
        "allow_skip": false
      },
      "assign": "answers.step_1",
      "next": "step_1_routing"
    },
